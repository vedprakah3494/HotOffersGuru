<!DOCTYPE html>

<html lang="">
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta content="" name="description" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <link rel="shortcut icon" href="#">
    <script src="~/Areas/Portal/Content/assets/js/jquery.min.js"></script>
    <script src="~/Areas/Portal/Content/assets/js/bootstrap.min.js"></script>
    <script src="~/Areas/Portal/Content/assets/js/animsition.min.js"></script>
    <script src="~/Areas/Portal/Content/owl.carousel/owl.carousel.min.js"></script>
    <script src="~/Areas/Portal/Content/assets/js/Hotoffers.js"></script>

    <link href="~/Areas/Portal/Content/assets/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Areas/Portal/Content/assets/css/icons.css" rel="stylesheet" />
    <link href="~/Areas/Portal/Content/assets/css/animate.min.css" rel="stylesheet" />
    <link href="~/Areas/Portal/Content/assets/css/animsition.min.css" rel="stylesheet" />
    <link href="~/Areas/Portal/Content/owl.carousel/assets/owl.carousel.css" rel="stylesheet" />

    <!-- Theme styles -->

    <link href="~/Areas/Portal/Content/assets/css/style.css" rel="stylesheet" />
</head>
<body>
    <div class="site-wrapper animsition" data-animsition-in="fade-in" data-animsition-out="fade-out">

        <header class="header">
            <div class="top-nav  navbar m-b-0 b-0">
                <div class="container">
                    <div class="row">
                        <!-- LOGO -->
                        <div class="topbar-left col-sm-3 col-xs-4">
                            <a href="#" class="logo"> <img src="~/Areas/Portal/Content/assets/images/logo.png" alt="" class="img-responsive"> </a>
                        </div>
                        <!-- End Logo container-->
                        <div class="menu-extras col-sm-9 col-xs-8">
                            <ul class="nav navbar-nav navbar-right pull-right">
                                <li>
                                    <form role="search" class="app-search pull-left hidden-xs">
                                        <div class="input-group">
                                            <input class="form-control" placeholder="Search Offer ..." aria-label="Text input with multiple buttons">
                                        </div>
                                        <a href="#"><i class="ti-search"></i></a>
                                    </form>
                                </li>

                            </ul>
                            <div class="menu-item">
                                <!-- Mobile menu toggle-->
                                <a class="navbar-toggle">
                                    <div class="lines"> <span></span> <span></span> <span></span> </div>
                                </a>
                                <!-- End mobile menu toggle-->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="navbar-custom shadow">
                <div class="container">
                    <div id="navigation">
                        <!-- Navigation Menu-->
                        <ul class="navigation-menu">
                            <li class="active"> <a href="#"><i class="ti-home"></i> <span> Home </span> </a> </li>
                            <li class="has-submenu">
                                <a href="#"><i></i> <span> Top Category </span> </a>
                                <ul class="submenu">
                                    <li><a href="#">Mobile, Tablets & Accessories</a> </li>
                                    <li><a href="#">Laptops & Peripherals</a> </li>
                                    <li><a href="#">TV & Entertainment Devices</a> </li>

                                </ul>
                            </li>
                            
                            <li class="has-submenu">
                                <a href="#"><i></i> <span>Offers & Coupon Code </span> </a>
                                <ul class="submenu">
                                    <li><a href="#">Amazon</a> </li>
                                    <li><a href="#">Flipkart</a> </li>

                                </ul>
                            </li>
                            <li> <a href="#"><span> Mobile Accessories </span> </a> </li>
                            <li> <a href="#"><span> Men Fashion </span> </a> </li>
                            <li> <a href="#"><span>Women Fashion </span> </a> </li>

                        </ul>
                        <!-- End navigation menu  -->
                    </div>
                </div>
            </div>
        </header>
    <div class="wrapper">
    <div class="container">
   
    @RenderBody()
    
    </div>
    </div>
    <footer id="footer">
        <div class="btmFooter">
            <div class="container">
                <div class="row">
                    <div class="col-sm-10 col-sm-offset-1 text-center">
                        <ul class="list-inline list-unstyled">
                            <li><a href="#">Home</a> </li>
                            <li><a href="#">About Us</a> </li>
                            <li><a href="#">FAQ</a> </li>
                            <li><a href="#">Contact Us</a> </li>
                        </ul>
                    </div>
                </div>
                <div class="col-sm-12 text-center m-t-20">
                    <p>
                        <strong>
                            Copyright 2016
                        </strong> HotOffersGuru <i class="ti-heart">
                        </i> <strong>
                            by HotOffersGuru
                        </strong>
                    </p>
                </div>
                
            </div>
        </div>
    </footer>

    </div>
</body>
</html lang="">
