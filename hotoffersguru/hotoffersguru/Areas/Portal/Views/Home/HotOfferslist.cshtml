@using hotoffersguru.Entity.ServiceEntity
@model hotoffersguru.Entity.ServiceEntity.FlipkartOffers

<div id="ending" class="tab-pane counties-pane animated fadeIn">
    <div class="row">
        @{
            foreach (var offer in Model.allOffersList.ToList())
            {
                <div class="col-sm-4">
                    <div class="widget">
                        <div class="coupon-block">
                            <a class="coupon-image bg-image" href="#" title="" data-image-src="@offer.imageUrls[0].url"></a>
                            <div class="coupon-value" content="40%">
                                @offer.description
                            </div>
                            <h4 class="coupon-title" style="min-height:80px">
                                <a href="@offer.url">@offer.title</a>
                            </h4>
                            <a href="@offer.url">
                                <div class="action-block">
                                    <p class="btn-code">
                                        <span class="btn-hover">GBRAB OFFER</span>
                                    </p>

                                </div>
                            </a>
                            <div class="row">
                                <div class="col-sm-12">
                                    <span class="expiry_date">
                                        Expires in
                                        <span class="expiry_days">@offer.endTime</span> <span class="expiry_hours"></span>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <!--//coupon block -->
                    </div>
                </div>

            }
        }


    </div>
    <ul class="pagination pagination-lg m-t-0">
        <li>
            <a href="#"> <i class="ti-arrow-left"></i> </a>
        </li>
        <li> <a href="#">1</a> </li>
        <li class="active"> <a href="#">2</a> </li>
        <li> <a href="#">3</a> </li>
        <li> <a href="#">4</a> </li>
        <li>
            <a href="#"> <i class="ti-arrow-right"></i> </a>
        </li>
    </ul>
</div>