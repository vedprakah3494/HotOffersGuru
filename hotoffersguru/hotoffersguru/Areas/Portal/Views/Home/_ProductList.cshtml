@model IEnumerable<hotoffersguru.Entity.Models.ProductDetail>

<div id="popular" class="tab-pane counties-pane active animated fadeIn">
    <div class="row">
        @{
            foreach (var item in Model)
            {

                <div class="col-sm-4">
                    <div class="widget">
                        <div class="coupon-block equal">
                            <a class="coupon-image bg-image" href="#" title="" data-image-src="@item.ProductAttribute.imageUrls._800x800"></a>
                            <div class="coupon-value" content="40%">@item.ProductAttribute.productDescription</div>
                            <h4 class="coupon-title"  style="min-height:100px"><a href="#">@item.ProductAttribute.imageUrls</a></h4>
                            <div class="action-block">
                                <a href="@item.ProductAttribute.productUrl">
                                    <p class="btn-code" data-type="code" data-link="">
                                        <span class="partial-code">FLIPKART</span> <span class="btn-hover">GRAB DEAL</span>
                                    </p>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
    <ul class="pagination pagination-lg m-t-0">
        <li>
            <a href="#"> <i class="ti-arrow-left"></i> </a>
        </li>
        <li class="active"> <a href="#">1</a> </li>
        <li > <a href="#">2</a> </li>
        <li> <a href="#">3</a> </li>
        <li> <a href="#">4</a> </li>
        <li>
            <a href="#"> <i class="ti-arrow-right"></i> </a>
        </li>
    </ul>
</div>

