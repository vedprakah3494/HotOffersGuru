@model IEnumerable<hotoffersguru.Entity.Models.ProductDetail>
@{
    ViewBag.Title = "HotOffersGuru";
    Layout = "~/Areas/Portal/Views/Shared/__Layout.cshtml";
}
<div class="row">
    <div class="col-lg-9">
        <div class="widget">
            <div class="widget-heading widget-default b-b-0">
                <h3 class="widget-title text-dark Category-title">
                 @ViewBag.CategoryName
                </h3>
                @*<div class="widget-widgets">
                    <div class="form-group sort">
                        <select class="select form-control">
                            <option value="">Popular</option>
                            <option value="">Latest</option>
                            <option value="">Ending soon</option>
                        </select>
                    </div>
                </div>*@
                <div class="clearfix"></div>
            </div>
        </div>
        <div id="#" class="tab-pane counties-pane  animated fadeIn">
            <div class="row">
                @{
                    foreach (var item in Model)
                    {

                        <div class="col-sm-4">
                            <div class="widget">
                                <div class="coupon-block equal">
                                    <a href="#" class="coupon-storelogo"> <img src="@Url.Content(item.StoreLogoUrl)" alt="" class="img-responsive"> </a>                                   
                                    <a class="coupon-image bg-image" href="#" title="" data-image-src="@item.ProductAttribute.imageUrls.LargeImage"></a>

                                    <div class="coupon-value" content="40%">
                                        Price: @item.ProductAttribute.sellingPrice
                                        @{
                                            if (item.ProductAttribute.discountPercentage != null)
                                            {
                                                <span> MRP:<strike> @item.ProductAttribute.maximumRetailPrice </strike></span>
                                            }
                                        }
                                    </div>
                                    @{
                                        if (item.ProductAttribute.discountPercentage != null)
                                        {
                                            <h4 class="coupon-discount">
                                                <a href="#">
                                                    You Saved : @item.ProductAttribute.savedAmount (@item.ProductAttribute.discountPercentage%)
                                                </a>
                                            </h4>
                                        }
                                        else
                                        {
                                            <h4 class="coupon-discount">
                                                <a href="#">
                                                    <br/>
                                                </a>
                                            </h4>
                                        }
                                    }
                                    <h4 class="coupon-title"><a href="#">@item.ProductAttribute.title</a></h4>
                                    <div class="action-block">
                                        <a href="@item.ProductAttribute.productUrl">
                                            <p class="btn-code" data-type="code" data-link="">
                                                <span class="partial-code"></span> <span class="btn-hover">GRAB DEAL</span>
                                            </p>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
            <ul class="pagination pagination-lg m-t-0">
                <li>
                    <a href="#"> <i class="ti-arrow-left"></i> </a>
                </li>
                <li class="active"> <a href="#">1</a> </li>
                <li> <a href="#">2</a> </li>
                <li> <a href="#">3</a> </li>
                <li> <a href="#">4</a> </li>
                <li>
                    <a href="#"> <i class="ti-arrow-right"></i> </a>
                </li>
            </ul>
        </div>
          
    </div>
    @{
        Html.RenderPartial("_CategoryDetail");
    }
</div>

